# ============================================================
# 复制为 .env 或在 Render 控制台配置环境变量
# ============================================================
# Cloudflare Workers AI 配置（完全免费，每天 10000 次）
# 1. 打开 https://dash.cloudflare.com/ → 选择账号
# 2. 账号 ID 在右侧 "API" 栏可以复制
# 3. API Token: 右上角头像 → "我的个人资料" → API 令牌 → 创建令牌
#    → 使用 "AI Workers" 模板 或 自定义（权限: Workers AI - 编辑）
# ============================================================

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
PORT=5000
FLASK_DEBUG=true
